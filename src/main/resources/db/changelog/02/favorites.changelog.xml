<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.21.xsd">

    <!-- Favorites -->
    <changeSet id="1-favorites" author="universall">
        <createTable tableName="favorites">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_favorites" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="favorite_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Favorites unique constraint -->
    <changeSet id="2-favorites-uk" author="universall">
        <addUniqueConstraint tableName="favorites"
                             columnNames="user_id, favorite_user_id"
                             constraintName="uk_favorites_user_favorite"/>
    </changeSet>

    <!-- FK base user -->
    <changeSet id="3-favorites-fk-user" author="universall">
        <addForeignKeyConstraint baseTableName="favorites"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 constraintName="fk_favorites_user"/>
        <createIndex indexName="idx_favorites_user_id" tableName="favorites">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <!-- FK favorite user -->
    <changeSet id="4-favorites-fk-favorite-user" author="universall">
        <addForeignKeyConstraint baseTableName="favorites"
                                 baseColumnNames="favorite_user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 constraintName="fk_favorites_favorite_user"/>
        <createIndex indexName="idx_favorites_favorite_user_id" tableName="favorites">
            <column name="favorite_user_id"/>
        </createIndex>
    </changeSet>

    <!-- Deny self-favorite constraint -->
    <changeSet id="5-favorites-no-self" author="universall">
        <sql><![CDATA[ALTER TABLE favorites ADD CONSTRAINT chk_favorites_not_self CHECK (user_id <> favorite_user_id)]]></sql>
    </changeSet>

</databaseChangeLog>
